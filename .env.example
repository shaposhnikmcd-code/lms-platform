# UIMP LMS — приклад env-файлу.
# Скопіюй у `.env.local` (локальна розробка) і заповни значення.
# `.env.local` gitignored, цей файл — у репозиторії, СЕКРЕТИ СЮДИ НЕ КЛАДЕМО.
#
# Нагадування про три окремі БД (див. CLAUDE.md → Local dev workflow):
#   localhost        → Neon branch `dev`
#   pre-production   → Neon project `uimp-pre` (Vercel scope=Preview)
#   main             → Neon prod (Vercel scope=Production)

# ─── База даних ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # pooled
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require     # direct (міграції)

# ─── Auth (NextAuth) ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Bootstrap-whitelist: email-и, яким автоматично створюється акаунт при першому
# OAuth-логіні, якщо їх ще немає в БД. Через кому.
ADMIN_EMAILS=
MANAGER_EMAILS=
SUPER_ADMIN_EMAILS=

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# ⚠️ ОБОВ'ЯЗКОВО НА ПРОДІ. Без цих двох змінних lib/ratelimit.ts переходить у
# fail-open: УСІ ліміти тихо вимикаються — включно з брутфорсом логіну,
# перебором промокодів, спамом платіжок і контактної форми. У проді на кожному
# cold start про це пишеться console.error, але сам запит все одно проходить.
# Локально можна лишити порожнім (ліміти вимкнені свідомо).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Платежі ──────────────────────────────────────────────────────────────────
WAYFORPAY_MERCHANT_LOGIN=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_PASSWORD=   # для regularApi REMOVE (скасування автосписань)
WAYFORPAY_TEST_MODE=
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MAP=

# ─── Пошта / розсилки ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=UIMP Education <edu@uimp.com.ua>
SENDPULSE_API_KEY=
SENDPULSE_SECRET_KEY=
SENDPULSE_OAUTH_CLIENT_ID=
SENDPULSE_OAUTH_SECRET=
SENDPULSE_EVENT_URL=
SENDPULSE_YEARLY_COURSE_ID=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                    # бот UIMP (канал Річної програми)
TELEGRAM_YEARLY_WEBHOOK_SECRET=
TELEGRAM_CONNECTOR_BOT_TOKEN=          # @connectorgame_bot
TELEGRAM_CONNECTOR_WEBHOOK_SECRET=

# ─── Інші інтеграції ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOVA_POSHTA_API_KEY=
DEEPL_API_KEY=

# ─── Внутрішні секрети ────────────────────────────────────────────────────────
CRON_SECRET=              # Authorization: Bearer <...> для /api/cron/*
EXTERNAL_SALES_SECRET=    # для /api/external-sales

# ─── Аналітика (публічні) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
